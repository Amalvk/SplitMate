# SplitMate runs entirely in local/demo mode with no configuration required.
# To connect a real Firebase project instead, copy this file to .env and fill these in
# from your Firebase project settings — the app will automatically switch to the Firebase-backed
# repositories (see src/services/repositories/index.ts) once every value below is set.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: with the values above set, also set this to "true" (and run `firebase emulators:start`
# in another terminal) to develop against the local Firebase Emulator Suite instead of your real
# project — same code paths, zero risk to production data. Never do anything in a production build.
VITE_USE_FIREBASE_EMULATOR=
